---
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
import { HeroClient } from '@/components/Hero.client';
import { LiveWorkFloatClient } from '@/components/LiveWorkFloat.client';
import { SkillsClient } from '@/components/Skills.client';
import { ExperienceClient } from '@/components/Experience.client';
import { CertificatesClient } from '@/components/Certificates.client';
import { GitHubStatsClient } from '@/components/GitHubStats.client';
import { TestimonialsClient } from '@/components/Testimonials.client';
import { ProjectsClient } from '@/components/Projects.client';
import { ContactFormClient } from '@/components/ContactForm.client';
import { uiStrings } from '@/lib/config';
---

	<BaseLayout schemaType="Profile">
		<main id="main-content" class="min-h-screen relative" aria-label="Dao Quang Truong professional portfolio">
			<HeroClient client:load />
			<LiveWorkFloatClient client:load />
			<SkillsClient client:visible />
		<ExperienceClient client:visible />
		<CertificatesClient client:visible />
		<GitHubStatsClient client:visible />
		<TestimonialsClient client:visible />
		<ProjectsClient client:visible />

		<!-- Contact Section -->
		<section id="contact" aria-labelledby="contact-heading" class="py-24 px-4 sm:px-6 lg:px-8 border-t border-border">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-20">
						<h2 id="contact-heading" class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4">
							{uiStrings.contact.title}
						</h2>
						<p class="text-base text-muted-foreground uppercase tracking-widest font-mono">
							{uiStrings.contact.subtitle}
					</p>
				</div>
				<ContactFormClient client:visible />
			</div>
		</section>
	</main>
</BaseLayout>
